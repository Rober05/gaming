// @dc:title "Project Vocabulary Bundle"
// @dc:description "Vocabulary bundle aggregating all project vocabularies."
vocabulary bundle <http://example.com/project/bundle#> as project_bundle {
    
    // Includes the method vocabularies
    includes <http://example.com/method/vocabulary#>
    includes <http://example.com/method/rules#>
    includes <http://example.com/method/patterns#>
}