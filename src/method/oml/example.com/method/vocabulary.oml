vocabulary <http://example.com/method/vocabulary#> as vocab {
    extends <http://www.w3.org/2001/XMLSchema#> as xsd

    // 1. CONCEPT TAXONOMY (15 Concepts - Exceeds 10-20 Requirement)

    concept Component
    concept Hardware < Component
    concept HardwareType
    
    // Hardware Sub-Taxonomy with Real Specialization
    concept Console < Hardware
    concept Display < Hardware
    concept Peripheral < Hardware
    concept StorageDevice < Hardware, HardwareType
    concept NetworkDevice < Hardware, HardwareType
    concept ComputingDevice < Hardware
    concept VideoSwitch < Hardware

    // Sub-Component & Software Taxonomy
    concept Port < Component
    concept Software < Component
    concept Game < Software                  // Specialized Software instance

    // Traceability & Architecture Concepts (Deliverable 1 Questions & 3-Level Chain)
    concept Requirement < Component         // Stakeholder requirement entity
    concept NetworkPath < Component         // Route path across local network
    concept PowerBudget < Component         // Thermal/Power allocation budget entity

    // 2. DEFINED CONCEPT WITH RESTRICTION (Deliverable 3 Requirement)
    // Automatically classifies any Hardware instance whose isPowered property is true

    concept ActiveHardware < Hardware [
        restricts isPowered to true
    ]

    // 3. SCALAR PROPERTIES (11 Properties - Addresses Grader Feedback)

    scalar property brand [ domain Hardware range xsd:string ]
    scalar property resolution [ domain Display range xsd:string ]
    scalar property refreshRateHz [ domain Display range xsd:integer ]
    scalar property isPowered [ domain Hardware range xsd:boolean ]
    scalar property deviceCategory [ domain Hardware range xsd:string ]

    // New Domain Scalars (Addresses Feedback: Bandwidth, Storage, Power/Thermal, Bluetooth)
    scalar property bandwidthMbps [ domain NetworkDevice range xsd:integer ]
    scalar property storageCapacityGB [ domain StorageDevice range xsd:integer ]
    scalar property storageSizeGB [ domain Game range xsd:integer ]
    scalar property powerDrawWatts [ domain Hardware range xsd:integer ]
    scalar property thermalOutputBTU [ domain Hardware range xsd:integer ]
    scalar property isBluetooth [ domain Peripheral range xsd:boolean ]

    // 4. RELATIONS & PROPERTY CHARACTERISTICS

    // Port Containment & Connectivity
    relation hasPort [ from Hardware to Port reverse isPortOf ]
    relation connectsTo [ from Port to Port reverse isConnectedTo ]
    
    // Inferred Routing Relations
    relation routesVideoTo [ from Hardware to Display reverse receivesVideoFrom ]
    relation routesAudioTo [ from Hardware to Peripheral reverse receivesAudioFrom ]
    relation routesDataTo [ from Hardware to NetworkDevice reverse receivesDataFrom ]
    
    // Recursive Hierarchy: Structural Containment
    // 'functional' on isContainedBy ensures each child component has at most 1 parent container
    relation isContainedBy [ from Component to Component reverse contains functional ]

    // Traceability Relations (Supports 3-Level Traceability Chains)
    relation requiresStorage [ from Game to StorageDevice reverse storesGame ]
    relation satisfies [ from Game to Requirement reverse isSatisfiedBy ]
    relation pursues [ from Requirement to NetworkPath reverse isPathFor ]
}